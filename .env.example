# ===========================================================================
# Support Ops Hub — local development environment variables
# Copy to .env and adjust as needed. .env is git-ignored.
# ===========================================================================

# --- Database (MySQL 8.0) ---
DB_DSN=app:app@tcp(127.0.0.1:3306)/support_ops_hub?parseTime=true&loc=Asia%2FTokyo&charset=utf8mb4
DB_ROOT_DSN=root:root@tcp(127.0.0.1:3306)/support_ops_hub?parseTime=true&loc=Asia%2FTokyo&charset=utf8mb4

# --- S3 (LocalStack) ---
S3_ENDPOINT=http://127.0.0.1:4566
S3_REGION=ap-northeast-1
S3_BUCKET=support-ops-hub-attachments-local
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_FORCE_PATH_STYLE=true

# --- JWT ---
JWT_SECRET=dev-only-not-for-production-change-me
# Short TTL because we are stateless (no Redis blocklist). 15 minutes is the
# accepted window between logout and effective revocation.
JWT_TTL=15m

# --- Service ports ---
GATEWAY_PORT=8000
AUTH_PORT=8001
TICKET_PORT=8002

# --- Frontend ---
NUXT_PUBLIC_API_BASE=http://127.0.0.1:8000/api/v1
