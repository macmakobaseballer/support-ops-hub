{
  "name": "support-ops-hub-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "audit:prod": "pnpm audit --prod --audit-level=high",
    "openapi:types": "openapi-typescript ../docs/api/openapi.yaml -o types/api.d.ts"
  },
  "dependencies": {
    "@pinia/nuxt": "^0.5.5",
    "@vueuse/core": "^11.3.0",
    "@vueuse/nuxt": "^11.3.0",
    "bootstrap-icons": "^1.13.1",
    "chart.js": "^4.5.1",
    "pinia": "^2.2.6",
    "vue": "^3.5.13",
    "vue-chartjs": "^5.3.3",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^0.7.2",
    "@nuxtjs/tailwindcss": "6.11.4",
    "@oxc-minify/binding-linux-x64-gnu": "0.129.0",
    "@oxc-parser/binding-linux-x64-gnu": "0.129.0",
    "@oxc-transform/binding-linux-x64-gnu": "0.129.0",
    "@pinia/testing": "^0.1.7",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^2.1.8",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.16.0",
    "happy-dom": "^15.11.7",
    "nuxt": "^3.14.1592",
    "openapi-typescript": "^7.4.4",
    "typescript": "^5.7.2",
    "unplugin-auto-import": "^21.0.0",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.1.10"
  },
  "packageManager": "pnpm@10.13.1",
  "pnpm": {
    "overrides": {
      "devalue": ">=5.8.1"
    }
  }
}
